---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import { getPerformanceOpeningDate, isUpcomingPerformance } from "@lib/utils";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const speaking: CollectionEntry<"speaking">[] = (
  await getCollection("speaking")
)
  .filter((speaker) => !speaker.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_SPEAKING_ON_HOMEPAGE);

const allPerformances: CollectionEntry<"performances">[] = (
  await getCollection("performances")
).filter((performance) => !performance.data.draft);

const upcomingPerformances = allPerformances
  .filter((performance) => isUpcomingPerformance(performance.data.dates))
  .sort(
    (a, b) =>
      getPerformanceOpeningDate(a.data.dates).valueOf() -
      getPerformanceOpeningDate(b.data.dates).valueOf(),
  );

const pastPerformances = allPerformances
  .filter((performance) => !isUpcomingPerformance(performance.data.dates))
  .sort(
    (a, b) =>
      getPerformanceOpeningDate(b.data.dates).valueOf() -
      getPerformanceOpeningDate(a.data.dates).valueOf(),
  );

const performances = [...upcomingPerformances, ...pastPerformances].slice(
  0,
  SITE.NUM_PERFORMANCES_ON_HOMEPAGE,
);

const hasUpcomingPerformance = performances.some((performance) =>
  isUpcomingPerformance(performance.data.dates),
);
const allPerformancesUpcoming =
  performances.length > 0 &&
  performances.every((performance) =>
    isUpcomingPerformance(performance.data.dates),
  );

const performancesTitle = allPerformancesUpcoming
  ? "Upcoming Performances"
  : hasUpcomingPerformance
    ? "Upcoming & Recent Performances"
    : "Recent Performances";
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <img
        src="/blake-profile-small.jpg"
        alt="Blake Burch"
        class="mb-4 ml-4 h-48 w-48 rounded-full object-cover"
      />
      <h1 class="animate font-semibold text-black dark:text-white">
        Hey there! 👋 I'm Blake.
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span class="animate">
              <p>
                By day, I'm a Technical Product Leader for AI & Data Platforms.
              </p>
              <p>
                By night, I'm a musician/songwriter, a board game connoisseur,
                and an improv aficionado.
              </p>
              <p>
                Whether you already know me, or want to get a better idea of who
                I am, this website serves as a central hub for everything
                related to my life. I kept it purposefully simple. Function over
                form.
              </p>
              <p>
                I'm currently at an inflection point where more time and effort
                is being poured into creative endeavors. This site serves as a
                mix of both professional and creative works.
              </p>

              <p>
                <li>Want to learn more <Link href="about/">about me</Link>?</li>
                <li>
                  Want to know what I'm up to <Link href="now/">now</Link>?
                </li>
                <li>Want to explore my <Link href="blog/">thoughts</Link>?</li>
                <li>
                  Want to know what I've <Link href="projects/">worked on</Link
                  >?
                </li>
                <li>
                  Want to hear me <Link href="speaking/">talk</Link> about something
                  interesting?
                </li>
                <li>
                  Want to see me <Link href="performances/">perform</Link> live?
                </li>
                <li>
                  Looking for something specific? Just type <kbd>/</kbd> to search.
                </li>
              </p>
              <p></p>
              <p>
                Hopefully, you'll find something here that interests you. If you
                do, please reach out! It would make my day.
              </p>
            </span>
          </article>
        </section>

        {
          performances.length > 0 && (
            <section class="animate space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-y-2">
                <h2 class="font-semibold text-black dark:text-white">
                  {performancesTitle}
                </h2>
                <Link href="/performances"> See all performances </Link>
              </div>
              <ul class="not-prose flex flex-col gap-4">
                {performances.map((performance) => (
                  <li>
                    <ArrowCard
                      entry={performance}
                      upcoming={isUpcomingPerformance(performance.data.dates)}
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent Speaking Engagements
            </h2>
            <Link href="/speaking"> See all engagements </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              speaking.map((speaking) => (
                <li>
                  <ArrowCard entry={speaking} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
