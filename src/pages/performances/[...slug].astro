---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import {
  formatPerformanceDateRange,
  getPerformanceOpeningDate,
  isUpcomingPerformance,
  readingTime,
  renderMarkdownLinks,
} from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import Link from "@components/Link.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tag from "@components/Tag.astro";
import { instrumentIcons, formatInstrumentLabel } from "@utils/instruments";

export async function getStaticPaths() {
  const performances = (await getCollection("performances"))
    .filter((performance) => !performance.data.draft)
    .sort(
      (a, b) =>
        getPerformanceOpeningDate(b.data.dates).valueOf() -
        getPerformanceOpeningDate(a.data.dates).valueOf(),
    );
  return performances.map((performance) => ({
    params: { slug: performance.slug },
    props: performance,
  }));
}
type Props = CollectionEntry<"performances">;

const performance = Astro.props;
const { Content, headings } = await performance.render();
const { showings, venues } = performance.data;
const dateRange = formatPerformanceDateRange(performance.data.dates);
// Shows can move between venues, each with its own event page. Only use the
// single header link when every showing shares one URL; otherwise link per date.
const eventURLs = [...new Set(showings.map((s) => s.eventURL).filter(Boolean))];
const singleEventURL = eventURLs.length === 1 ? eventURLs[0] : undefined;
---

<Layout title={performance.data.title} description={performance.data.description} tags={performance.data.tags}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/performances">Back to performances</BackToPrevious>
    </div>
    <div class="animate my-10 space-y-1">
      <div class="flex flex-wrap items-center gap-1.5">
        <div class="font-base text-sm">
          {showings.length === 1 ? (
            <FormattedDate date={showings[0].date} />
          ) : (
            dateRange
          )}
        </div>
        {
          venues.length > 0 && (
            <>
              &bull;
              <div class="font-base text-sm">
                {venues.join(" & ")}
              </div>
            </>
          )
        }
        &bull;
        <div class="font-base text-sm">
          {readingTime(performance.body).text}
        </div>
      </div>
      <h1 class="text-3xl font-semibold text-black dark:text-white">
        {performance.data.title}
      </h1>
      <p class="mt-2 text-lg" set:html={renderMarkdownLinks(performance.data.description)} />
      {
        showings.length > 1 && (
          <div class="mt-4">
            <h2 class="text-sm font-semibold text-black dark:text-white">
              {showings.length} performances
            </h2>
            <ul class="mt-2 space-y-1 text-sm text-neutral-700 dark:text-neutral-300">
              {showings.map((showing) => (
                <li class="flex flex-wrap items-center gap-1.5">
                  <FormattedDate date={showing.date} />
                  {venues.length > 1 && showing.venue && (
                    <>
                      &bull;
                      <span>{showing.venue}</span>
                    </>
                  )}
                  {!singleEventURL && showing.eventURL && isUpcomingPerformance([showing.date]) && (
                    <>
                      &bull;
                      <Link href={showing.eventURL}>tickets</Link>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        (performance.data.videoURL || performance.data.audioURL || singleEventURL) && (
          <nav class="mt-4 flex gap-1">
            {performance.data.videoURL && (
              <Link href={performance.data.videoURL}>
                video
              </Link>
            )}
            {performance.data.audioURL && (
              <Link href={performance.data.audioURL}>
                audio
              </Link>
            )}
            {singleEventURL && (
              <Link href={singleEventURL}>
                event
              </Link>
            )}
          </nav>
        )
      }
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {performance.data.instruments && performance.data.instruments.map((instrument: string) => (
          <Tag
            name={instrument}
            icon={instrumentIcons[instrument]}
            label={formatInstrumentLabel(instrument)}
          />
        ))}
        {performance.data.tags && performance.data.tags.map((tag: string) => (
          <Tag name={tag} />
        ))}
      </div>
    </div>
    <TableOfContents headings={headings} />
    <article class="animate">
      <Content />
    </article>
  </Container>
</Layout>
