---
import type { CollectionEntry } from "astro:content";
import Tag from './Tag.astro';
import { cn, formatPerformanceDateSummary, readingTime } from '../lib/utils';
import { instrumentIcons, formatInstrumentLabel } from '../utils/instruments';

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"speaking">
    | CollectionEntry<"performances">;
  upcoming?: boolean;
};

const { entry, upcoming = false } = Astro.props;
const tags = entry.data.tags || [];
const displayTags = tags.slice(0, 3); // Display up to 3 tags
const readTime = entry.collection === "blog" ? readingTime(entry.body) : null;
const venue =
  entry.collection === "performances" ? entry.data.venue : undefined;
const performanceDates =
  entry.collection === "performances"
    ? formatPerformanceDateSummary(entry.data.dates)
    : undefined;
const instruments =
  entry.collection === "performances" ? entry.data.instruments : undefined;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class={cn(
    "not-prose group relative flex flex-nowrap rounded-lg border px-4 py-3 pr-10 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white",
    upcoming
      ? "border-emerald-400/60 bg-emerald-500/5 dark:border-emerald-400/40 dark:bg-emerald-400/10"
      : "border-black/15 dark:border-white/20",
  )}
>
  <div class="flex flex-1 flex-col justify-between">
    <div>
      {
        upcoming && (
          <span class="mb-1 inline-block rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">
            Upcoming
          </span>
        )
      }
      <div class="font-semibold">
        {entry.data.title}
      </div>
      {
        performanceDates && (
          <div class="text-sm text-neutral-600 dark:text-neutral-400">
            {performanceDates}{venue && ` at ${venue}`}
          </div>
        )
      }
      <div class="mt-2 text-sm">
        {entry.data.description}
      </div>
    </div>
    {(instruments?.length || displayTags.length > 0 || readTime) && (
      <div class="mt-2 flex flex-wrap items-center gap-4">
        {instruments?.map((instrument) => (
          <Tag
            name={instrument}
            icon={instrumentIcons[instrument]}
            label={formatInstrumentLabel(instrument)}
          />
        ))}
        {displayTags.map((tag) => (
          <Tag name={tag} />
        ))}
        {readTime && (
          <span class="text-xs text-neutral-500 dark:text-neutral-400">
            {readTime.text}
          </span>
        )}
      </div>
    )}
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>